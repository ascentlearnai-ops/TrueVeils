{
  "name": "truveil-recruiter",
  "version": "1.0.0",
  "description": "Truveil Recruiter App",
  "main": "main.js",
  "author": "Truveil Inc.",
  "scripts": {
    "build:website-demo": "node scripts/build-website-demo.js",
    "test": "node --test test/*.test.js",
    "brand:sync": "node scripts/sync-brand-assets.cjs --sync",
    "brand:check": "node scripts/sync-brand-assets.cjs --check",
    "release:check": "node scripts/check-release.js",
    "readiness:check": "node scripts/check-readiness.js",
    "prestart": "node scripts/sync-brand-assets.cjs --check && node scripts/build-provider-review.js && node scripts/write-runtime-config.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild:mac": "node scripts/mac-release.cjs --check-host",
    "build:mac": "node scripts/mac-release.cjs --build",
    "build:mac:arm64": "node scripts/mac-release.cjs --build --arch arm64",
    "build:mac:x64": "node scripts/mac-release.cjs --build --arch x64",
    "release:mac:check": "node scripts/mac-release.cjs --verify",
    "release:mac:stage": "node scripts/mac-release.cjs --stage",
    "prebuild:win": "node scripts/sync-brand-assets.cjs --check && node scripts/build-provider-review.js && node scripts/write-runtime-config.js --production",
    "build:win": "electron-builder --win",
    "postbuild:win": "node scripts/release-artifact.js --stage",
    "build:all": "node scripts/mac-release.cjs --all"
  },
  "dependencies": {
    "@remotion/install-whisper-cpp": "^4.0.467",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13"
  }
}
